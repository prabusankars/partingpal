# Copy to backend/.env and fill in. Never commit the real file.

# Postgres in production; SQLite works for local development.
DATABASE_URL=postgresql+psycopg://partingpal:partingpal@localhost:5432/partingpal
# DATABASE_URL=sqlite:///./partingpal.db

FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
COMPANY_NAME=Acme Corp

# ---- LLM providers: configure any subset. HR picks one per interview. ----
DEFAULT_PROVIDER=gemini

OPENAI_API_KEY=
OPENAI_MODELS=gpt-4.1-mini,gpt-4.1
OPENAI_TRANSCRIPTION_MODEL=whisper-1

GEMINI_API_KEY=AIzaSyDJ5L-tw-M6oF5YBSid2hASSvGjq2GcY5o
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro

# Open-source models through any OpenAI-compatible server:
#   Ollama:    OSS_BASE_URL=http://localhost:11434/v1   (ollama pull qwen2.5:7b-instruct)
#   vLLM:      OSS_BASE_URL=http://localhost:8001/v1
#   DashScope: OSS_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  OSS_API_KEY=sk-...  OSS_MODELS=qwen-plus
OSS_BASE_URL=
OSS_API_KEY=not-needed
OSS_MODELS=qwen2.5:7b-instruct,qwen3:8b

# Voice input: openai | gemini (defaults to whichever is configured)
TRANSCRIPTION_PROVIDER=

# ---- Interview flow ----
MAX_USER_TURNS=20
MAX_FOLLOWUPS_PER_TOPIC=1
LINK_VALID_DAYS=14

# ---- HR dashboard sign-in (Google). Access is denied unless listed here. ----
GOOGLE_CLIENT_ID=AIzaSyDJ5L-tw-M6oF5YBSid2hASSvGjq2GcY5o
ADMIN_ALLOWED_EMAILS=hr.lead@acme.com
ADMIN_ALLOWED_DOMAINS=
# Local development only: skips sign-in entirely.
AUTH_DISABLED=false

# ---- Optional: email invitations ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
